# syntax=docker/dockerfile:1
# Stage 1: Build sentinel binary
FROM golang:1.26 AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -trimpath -o sentinel ./cmd/sentinel/main.go

# Stage 2: Scratch image (< 5MB)
FROM scratch
WORKDIR /
COPY --from=builder /workspace/sentinel /sentinel
EXPOSE 8080
ENTRYPOINT ["/sentinel"]
